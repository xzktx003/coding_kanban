{
  "name": "@agent-orchestrator/session-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./package.json",
    "./item-detail": "./dist/codex/item-detail-channel.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "audit": "tsx src/audit.ts",
    "test": "tsx --test --test-concurrency=4 src/**/*.test.ts",
    "start": "node dist/main.js",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@agent-orchestrator/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@fastify/websocket": "^11.2.0",
    "@iarna/toml": "2.2.5",
    "better-sqlite3": "12.11.1",
    "fastify": "^5.6.0",
    "ignore": "7.0.5",
    "node-pty": "1.2.0-beta.12",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
