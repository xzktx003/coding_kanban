# Coding Kanban — example environment file.
#
# Copy this file to `.env` at the repository root and adjust values for your
# machine. `.env` itself is git-ignored; only this template is committed so
# everyone sees which variables exist.
#
# `scripts/restart-dev.sh` automatically reads dotenv assignments from `.env`
# if it exists, and both the Fastify backend (`apps/server`) and the Vite dev
# server (`apps/web`) read these variables at startup.

# ---------- Backend (apps/server) ----------
# Address the Fastify server binds to. Use 0.0.0.0 to accept LAN clients.
# Prefer SERVER_BIND_HOST over HOST — conda environments pollute HOST with
# the platform triplet (e.g. x86_64-conda-linux-gnu).
SERVER_BIND_HOST=0.0.0.0
# TCP port for the Fastify server (REST + WebSocket).
PORT=4000
# Per active PTY session replay buffer kept by the backend for terminal
# remount/reconnect. Increase for very long Codex outputs; higher values use
# more backend memory per active terminal.
TERMINAL_SCROLLBACK_BYTES=4194304
# Lines captured from tmux when refreshing observe-only sessions.
TERMINAL_TMUX_CAPTURE_LINES=20000
# Fallback output entries retained in the registry when no live PTY exists.
TERMINAL_REGISTRY_OUTPUT_ENTRIES=5000
# Local session metadata used to restore board cards and managed tmux sessions
# after a backend restart. Keep this outside version control.
# SESSION_STATE_PATH=.dev-runtime/agent-sessions.json
# Source tree fingerprinted by the update detector. Defaults to the repo root.
# APP_SOURCE_ROOT=/absolute/path/to/coding_kanban
# Periodically fetch and check the configured upstream branch.
# Use 10 or 30 minutes; use 0 or leave unset to disable. The background task
# never pulls: a fast-forward is attempted only after explicit UI confirmation.
GIT_AUTO_PULL_INTERVAL_MINUTES=10

# ---------- Frontend (apps/web / Vite dev server) ----------
# Address the Vite dev server binds to.
WEB_HOST=0.0.0.0
# TCP port for the Vite dev server.
WEB_PORT=8484
# Host:port the Vite proxy should use when forwarding /api, /ws and /vscode
# to the backend. Useful when backend runs on a different host (e.g. in a
# container) than the Vite dev server.
WEB_BACKEND_HOST=localhost
WEB_BACKEND_PORT=4000
# xterm.js scrollback lines kept in the browser for mounted terminals.
VITE_TERMINAL_SCROLLBACK_LINES=20000

# ---------- Frontend HTTPS ----------
# HTTPS is ON by default — required for browser Notification API on LAN IPs.
# Set to 0 only if you need plain HTTP (notifications will be unavailable).
WEB_HTTPS=1
# VITE_DEV_HTTPS_CERT=/absolute/path/to/cert.pem
# VITE_DEV_HTTPS_KEY=/absolute/path/to/key.pem
# Optional CA certificate that signed the frontend certificate. When set, it
# must verify WEB_HTTPS_CERT and is exposed as a public download for browser
# trust setup; never point this at a private key.
# WEB_HTTPS_CA_CERT=/absolute/path/to/root-ca.pem

# ---------- Playwright ----------
# Frontend protocol Playwright should use for baseURL and webServer probing.
# Set to https only when WEB_HTTPS=1.
# PLAYWRIGHT_FRONTEND_PROTOCOL=http

# ---------- Codex -> Feishu completion notifications ----------
# Used by scripts/codex-feishu-notify.mjs when Codex emits
# agent-turn-complete. Configure exactly one destination; leave both commented
# to keep outbound notifications disabled until a recipient is chosen.
# FEISHU_NOTIFY_CHAT_ID=oc_xxx
# FEISHU_NOTIFY_USER_ID=ou_xxx
# Maximum number of final-assistant-message characters included in Feishu.
# 完整最后输出按此字符数分片发送，不会截断；范围 1000-30000
FEISHU_NOTIFY_MESSAGE_CHUNK_CHARS=12000
# Per-attempt lark-cli timeout and total attempts (bounded by the script).
FEISHU_NOTIFY_TIMEOUT_MS=10000
FEISHU_NOTIFY_MAX_ATTEMPTS=2

# ---------- File browser ----------
# Default directory the built-in file browser opens on first load. Leave
# blank to fall back to the repository root (auto-detected via
# pnpm-workspace.yaml).
# FILE_BROWSER_DEFAULT_LOCAL_PATH=/data01/home/you/projects

# ---------- VS Code Web integration ----------
# Shared extensions directory for the embedded code-server. Defaults to
# ~/.vscode-server/extensions if available.
# VSCODE_WEB_EXTENSIONS_DIR=~/.vscode-server/extensions
# Public host seen by browsers when proxying /vscode — leave blank to use
# the request Host header.
# VSCODE_WEB_PUBLIC_HOST=
# Address code-server binds to internally. Defaults to 0.0.0.0.
# VSCODE_WEB_BIND_HOST=0.0.0.0
# Remote code-server bind address used for SSH-backed VS Code Web sessions.
# Defaults to 127.0.0.1 because the backend reaches it through SSH local forwarding.
# VSCODE_WEB_REMOTE_BIND_HOST=127.0.0.1
# Preferred remote code-server TCP port for SSH-backed VS Code Web sessions.
# VSCODE_WEB_REMOTE_PORT=13338
